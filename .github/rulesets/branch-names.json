{
  "name": "branch naming convention",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/feat-*",
        "refs/heads/fix-*",
        "refs/heads/doc-*",
        "refs/heads/cicd-*",
        "refs/heads/refactor-*",
        "refs/heads/dependabot/**/*",
        "refs/heads/changeset-release/*"
      ]
    }
  },
  "rules": [{ "type": "creation" }]
}
